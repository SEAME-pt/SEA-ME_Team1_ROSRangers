drone/ground/logs
# Env files: the real values (ROS domains, discovery), given by the safety
# pilot, never committed. Templates with empty values: .env.example, env.example/
# .env stays unanchored: a .env anywhere is kept out of git
.env
/drone/ground/env/
results/
.pio
.vscode/
.coverage
temp/
build*/

# Late-check replay fixtures (#204): bench data, built locally by make_replay.py
