# Real mode: the drone, through flight_interface (backend esp, real.yaml). Follow the Safety Rules.
#
# Copy to env/real.env (git ignores env/) and fill in the empty values with the
# ones the safety pilot gives you. Never commit the filled-in file, and never
# put the values in this template.
#   mkdir -p env && cp env.example/real.env.example env/real.env
# Until every value is set, compose refuses to start (real.env is read by
# make real through --env-file).
#
# What this mode is (keep as is):
COMPOSE_PROFILES=real
GROUND_MODE=real
#
# From the safety pilot:
#   GROUND_DOMAIN_ID        this mode's ROS domain (0-101, never 81-98: the tests',
#                           never 0 or 42: native runs' defaults, ADR-025 E1.4),
#                           a different one for each mode (ADR-025 E1.3)
#   GROUND_DISCOVERY_RANGE  LOCALHOST or SUBNET (ADR-025 E1, E1.2)
GROUND_DOMAIN_ID=
GROUND_DISCOVERY_RANGE=
