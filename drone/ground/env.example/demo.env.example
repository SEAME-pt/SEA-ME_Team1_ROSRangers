# Demo mode: gesture -> intent -> mission with the PRETEND /flight/state (fake_flight_state). Never with a real drone.
#
# Copy to env/demo.env (git ignores env/) and fill in the empty values with the
# ones the safety pilot gives you. Never commit the filled-in file, and never
# put the values in this template.
#   mkdir -p env && cp env.example/demo.env.example env/demo.env
# Until every value is set, compose refuses to start (demo.env is read by
# make through --env-file).
#
# What this mode is (keep as is):
COMPOSE_PROFILES=demo
GROUND_MODE=demo
#
# From the safety pilot:
#   GROUND_DOMAIN_ID        this mode's ROS domain (0-101, never 81-98: the tests'),
#                           a different one for each mode (ADR-025 E1.3)
#   GROUND_DISCOVERY_RANGE  LOCALHOST or SUBNET (ADR-025 E1, E1.2)
GROUND_DOMAIN_ID=
GROUND_DISCOVERY_RANGE=
