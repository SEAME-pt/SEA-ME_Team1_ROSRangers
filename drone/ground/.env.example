# The default for a plain `docker compose ...` run in drone/ground/ (the
# Makefile's rules use env/<mode>.env instead and never read this file).
#
# Copy to .env (git ignores it) and fill in the empty values with the demo's
# values from the safety pilot, or link it to your filled-in demo file:
#   cp .env.example .env            # then fill it in
#   ln -s env/demo.env .env         # or: the same values as make
# Never commit .env, and never put the values in this template. Until every
# value is set, compose refuses to start.
COMPOSE_PROFILES=demo
GROUND_MODE=demo
#   GROUND_DOMAIN_ID        the demo's ROS domain (from the safety pilot; never
#                           0, 42 or 81-98, ADR-025 E1.3/E1.4)
#   GROUND_DISCOVERY_RANGE  LOCALHOST or SUBNET (from the safety pilot)
GROUND_DOMAIN_ID=
GROUND_DISCOVERY_RANGE=
