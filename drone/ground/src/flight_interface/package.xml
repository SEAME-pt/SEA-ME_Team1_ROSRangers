<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>flight_interface</name>
  <version>0.1.0</version>
  <description>Ground link to the flight controller. For now: polls the FC over MSP (USB, or UDP through the ESP bridge) and publishes /fc/attitude and /fc/battery. The lifecycle node (#103) comes later.</description>
  <maintainer email="bmmc136@gmail.com">Bruno</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>

  <exec_depend>python3-serial</exec_depend>  <!-- msp.py SerialTransport -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
